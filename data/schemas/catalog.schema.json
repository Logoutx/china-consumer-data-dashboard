{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://china-consumer-dashboard/schemas/catalog.schema.json",
  "title": "Catalog manifest",
  "description": "The single manifest of every series and panel plus the 8 sections. See docs/DATA-CONTRACT.md sections 2, 5, 6. Renderers read the catalog to build navigation without opening series files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generated_at", "sections", "series"],
  "properties": {
    "schema": { "const": "catalog/v1" },
    "version": { "type": "string", "description": "Bumped when the catalog structure or membership changes." },
    "generated_at": { "type": "string", "format": "date-time" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh", "name_en", "order"],
        "properties": {
          "id": { "$ref": "#/definitions/section_id" },
          "name_zh": { "type": "string" },
          "name_en": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "series": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" },
      "description": "All series AND panels, sorted by (section order, tier, id)."
    }
  },
  "definitions": {
    "section_id": {
      "enum": [
        "prices",
        "consumption",
        "income-confidence",
        "employment",
        "property",
        "money-credit",
        "macro",
        "high-frequency"
      ],
      "description": "物价 / 消费 / 收入与信心 / 就业 / 楼市 / 钱与信贷 / 宏观大盘 / 高频脉搏."
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_zh", "name_en", "section", "tier", "unit_zh", "unit_en", "value_type", "freq", "calibers", "source", "file"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(-[a-z0-9]+)+$" },
        "name_zh": { "type": "string" },
        "name_en": { "type": "string" },
        "short_zh": { "type": "string", "description": "Optional compact label for tiles." },
        "short_en": { "type": "string" },
        "section": { "$ref": "#/definitions/section_id" },
        "group": { "type": "string", "description": "Sub-group within the section (e.g. 城乡, 商品分类)." },
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "1 headline (landing tile), 2 secondary, 3 detail/breakdown."
        },
        "unit_zh": { "type": "string" },
        "unit_en": { "type": "string" },
        "value_type": { "enum": ["level", "index", "mom_pct", "yoy_pct", "rate_pct", "count", "ratio"] },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "freq": { "enum": ["M", "Q", "A"] },
        "calibers": {
          "type": "array",
          "items": { "enum": ["single", "ytd", "mom"] },
          "uniqueItems": true,
          "minItems": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agency"],
          "properties": {
            "agency": { "enum": ["nbs", "pbc", "mof", "mohurd", "customs", "caam", "safe", "cflp"] },
            "dataset_zh": { "type": "string" },
            "dataset_en": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cadence": { "enum": ["monthly", "quarterly", "annual", "irregular"] },
                "window": { "type": "string", "description": "Human window, e.g. 'mid-month' or 'day 9-16'." },
                "typical_time_cn": { "type": "string", "description": "e.g. '10:00' Beijing time." }
              },
              "description": "Drives config/release_calendar.yaml and the Actions poller."
            }
          }
        },
        "breaks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effective", "kind", "no_yoy_across"],
            "properties": {
              "effective": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])|-Q[1-4])?$" },
              "kind": { "enum": ["rebase", "redefinition", "methodology", "indicator_replacement", "suspended", "resumed"] },
              "no_yoy_across": { "type": "boolean" }
            }
          },
          "description": "Mirror of the series-file breaks, for catalog-level filtering."
        },
        "derived": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "inputs"],
              "properties": {
                "rule": { "type": "string" },
                "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          ]
        },
        "related": { "type": "array", "items": { "type": "string" }, "description": "Related series ids (siblings, components)." },
        "supersedes": { "type": ["string", "null"] },
        "superseded_by": { "type": ["string", "null"] },
        "start": { "type": ["string", "null"], "pattern": "^\\d{4}(-(0[1-9]|1[0-2])|-Q[1-4])?$", "description": "First period, for quick catalog rendering." },
        "latest": { "type": ["string", "null"], "pattern": "^\\d{4}(-(0[1-9]|1[0-2])|-Q[1-4])?$", "description": "Latest period." },
        "panel": {
          "oneOf": [
            { "type": "boolean", "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimensions", "measures"],
              "properties": {
                "dimensions": {
                  "type": "object",
                  "additionalProperties": { "type": "array", "items": { "type": "string" } },
                  "description": "e.g. {city:[...70], metric:[new_home, resale_home]}."
                },
                "measures": { "type": "array", "items": { "enum": ["m", "m_yoy", "ytd", "ytd_yoy", "mom", "real_yoy"] } }
              }
            }
          ],
          "default": false,
          "description": "false for a normal series; object for a panel entry (70-city). See DATA-CONTRACT section 5."
        },
        "file": { "type": "string", "description": "Repo-relative path, e.g. data/series/nbs-retail-total.json or data/panels/nbs-70city-price.json." }
      }
    }
  }
}
